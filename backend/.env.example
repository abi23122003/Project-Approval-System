# Development defaults only. Django does not load this file automatically;
# export the values in your shell or configure them in your process manager.
DJANGO_ENV=development
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4028,http://127.0.0.1:4028
CSRF_TRUSTED_ORIGINS=http://localhost:4028,http://127.0.0.1:4028
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# Password recovery: configure a real SMTP service in deployed environments.
# Development defaults to Django's console email backend.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.edu
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.edu
# PASSWORD_RESET_FRONTEND_URL=https://app.example.edu/reset-password

# Optional local signing key. If omitted in development, Django generates an
# ephemeral key at startup and existing tokens expire when the server restarts.
# DJANGO_SECRET_KEY=

# Optional. Set only when TLS terminates at a trusted reverse proxy that
# overwrites the forwarded protocol header.
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO=https

DJANGO_DB=sqlite
# DJANGO_SQLITE_PATH=backend/db.sqlite3

# For PostgreSQL, select DJANGO_DB=postgres and provide:
# POSTGRES_DB=project_approval_db
# POSTGRES_USER=your_database_user
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
